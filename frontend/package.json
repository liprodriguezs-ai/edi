{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:email": "email build --packageManager pnpm",
    "dev:email": "email dev",
    "export:email": "email export --pretty",
    "export:email:blade": "BLADE_OUTPUT=true email export --pretty",
    "copy-emails": "pnpm run export:email:blade && mkdir -p ../backend/Modules/Email/resources/views ../backend/public/email/static && cp -r out/* ../backend/Modules/Email/resources/views/ && (cp -r emails/static/* ../backend/public/email/static/ 2>/dev/null || true) && for f in ../backend/Modules/Email/resources/views/*.html; do [ -f \"$f\" ] && mv \"$f\" \"${f%.html}.blade.php\"; done",
    "build:dev": "vite build --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --mode staging",
    "dev:development": "vite --mode development",
    "dev:localhost": "vite --mode localhost",
    "dev:staging": "vite --mode staging",
    "dev:production": "vite --mode production",
    "build": "vite build --mode production",
    "build:development": "vite build --mode development",
    "build:localhost": "vite build --mode localhost",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "pnpm run build && wrangler dev",
    "preview:development": "vite preview --mode development",
    "preview:localhost": "vite preview --mode localhost",
    "preview:staging": "vite preview --mode staging",
    "preview:production": "vite preview --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -p --project tsconfig.app.json --noEmit --strict",
    "clean": "rm -rf dist node_modules/.vite coverage",
    "analyze": "npx vite-bundle-analyzer",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretty-quick": "pretty-quick --staged",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
