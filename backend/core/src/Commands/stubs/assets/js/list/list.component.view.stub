<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>{{'$TITLE_NAME$' | translate}}<small> Catálogo</small></h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item">
                        <a ui-sref="app.landing">
                            <i class="fa fa-dashboard"></i> Home</a>
                    </li>
                    <li class="breadcrumb-item active">{{'$PLURAL_NAME$' | translate}}}</li>
                </ol>
            </div>
        </div>
    </div>
</section>
<section class="content" ng-intro-options="vm.IntroOptions" ng-intro-method="showIntro">
    <div class="container-fluid">
        <div class="col-md-12">
            <div class="card card-outline card-danger">
                <div class="card-header with-border">
                    <h3 class="card-title">{{'List of' | translate}} {{'$PLURAL_NAME$' | translate}}</h3>
                    <div class="card-tools" hl-sticky="">
                        <a href="javascript:" id="intro-btn-new" ng-user-can="create.$CAMEL_NAME$" ng-click="vm.openModalNew()" class="btn btn-secondary">
                            <i class="fa fa-plus-square"></i> {{'New' | translate}}</a>

                        <div class="btn-group" uib-dropdown dropdown-append-to-body ng-user-can="report.$CAMEL_NAME$"
                            id="intro-buttons-export">
                            <button id="btn-append-to-body" type="button" class="btn btn-secondary" uib-dropdown-toggle>
                                <i class="fas fa-download"></i> {{'Export' | translate}}
                                <span class="caret"></span>
                            </button>
                            <div class="dropdown-menu" uib-dropdown-menu role="menu" aria-labelledby="btn-append-to-body">
                                <a class="dropdown-item" href="javascript:"  ng-click="vm.onReport('xls')">
                                    <i class="fas fa-file-excel text-success"></i> Excel</a>
                                <a class="dropdown-item" href="javascript:" ng-click="vm.onReport('pdf')">
                                    <i class="fas fa-file-pdf text-danger"></i> PDF</a>
                            </ul>
                        </div>
                        <button type="button" ng-click="showIntro()" class="btn btn-secondary" title="{{'Help' | translate}}">
                            <i class="fas fa-question-circle"> </i> {{'Help' | translate}}
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="row p-3">
                        <div class="col-sm-12">
                            <div class="float-right" id="intro-status-options">
                                <div class="custom-control custom-checkbox custom-control-inline">
                                    <input type="checkbox" class="custom-control-input" ng-change="vm.onQuery()" id="$CAMEL_NAME$CheckActive"
                                        ng-true-value="1" ng-false-value="0" ng-model="vm.pagination.active">
                                    <label class="custom-control-label form-check-label" for="$CAMEL_NAME$CheckActive">{{'Active' | translate}}</label>
                                </div>
                                <div class="custom-control custom-checkbox custom-control-inline">
                                    <input type="checkbox" class="custom-control-input" ng-change="vm.onQuery()" id="$CAMEL_NAME$CheckInactive"
                                        ng-true-value="1" ng-false-value="0" ng-model="vm.pagination.inactive">
                                    <label class="custom-control-label form-check-label" for="$CAMEL_NAME$CheckInactive">{{'Inactive' | translate}}</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div dw-loading="list-loader">
                        <div class="table-responsive" id="intro-list-rows">
                        <table md-table md-progress="vm.promise" id="list$CAMEL_NAME$"
                                class="table table-striped  table-hover">
                            <caption class="text-center" ng-if="vm.promiseQuery == false && vm.list.length == 0" ng-cloak>
                                <i class="fa fa-search"></i>  {{'Information not found' | translate}}</caption>
                            <thead  class="thead-dark">
                            <tr>
                                <th class="no-colvis">ID</th>
                                <th>{{'Name' | translate}}</th>
                                <!--REPLACE_DATA_TITLE_TABLE-->
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr ng-repeat="row in vm.list" ng-class="{ 'table-warning': row.deleted_at}">
                                <td>{{row.id}}</td>
                                <td>{{row.name}}</td>
                                <!--REPLACE_DATA_COLUMN_TABLE-->
                                <td class="text-center">
                                    <div ng-if="row.deleted_at" class="" role="group">
                                        <a href="javascript:" ng-user-can="restore.$CAMEL_NAME$"  uib-tooltip="{{'Activate' | translate}}"
                                           ng-click="vm.onRestore(row)" class="btn btn-success">
                                            <i class="fa fa-lg fa-reply"></i>
                                        </a>
                                    </div>
                                    <div ng-if="!row.deleted_at" class="" role="group">
                                        <a href="javascript:" ng-user-can="update.$CAMEL_NAME$" uib-tooltip="{{'Edit' | translate}}"
                                           ng-click="vm.openModalEdit(row)" class="btn btn-primary">
                                            <i class="fa fa-pencil-alt"></i>
                                        </a>
                                        <a href="javascript:" ng-user-can="delete.$CAMEL_NAME$" uib-tooltip="{{'Inactivate' | translate}}"
                                           ng-click="vm.onDelete(row)" class="btn btn-danger">
                                            <i class="fa fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="float-rigth">
                        <ng-pagination vm="vm"></ng-pagination>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script type="text/ng-template" id="$CAMEL_NAME$ModalNew.html">
    <div class="modal-header">
        <a class="btn btn-default" href="javascript:" ng-click="vm.closeModalNew({})"><span class="fas fa-times"></span></a>
    </div>
    <div class="modal-body subcomponent-modal">
        <$KEBAB_NAME$-add event="vm.closeModalNew(data)" subcomponent="true"></$KEBAB_NAME$-add>
    </div>
</script>
<script type="text/ng-template" id="$CAMEL_NAME$ModalEdit.html">
    <div class="modal-header">
        <a class="btn btn-default" href="javascript:" ng-click="vm.closeModalEdit({})"><span
                class="fas fa-times"></span></a>
    </div>
    <div class="modal-body subcomponent-modal">
        <$KEBAB_NAME$-edit event="vm.closeModalEdit(data)" subcomponent="true"
                      datacomponent="{ row : vm.currenRow}"></$KEBAB_NAME$-edit>
    </div>
</script>
