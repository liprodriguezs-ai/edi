{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-drift-check.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enabledPlugins": {},
  "mcpServers": {
    "db": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub",
        "--dsn",
        "postgresql://rodriguez@127.0.0.1:5432/residia"
      ],
      "env": {}
    },
    "laravel-boost": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "cd backend && php artisan boost:mcp"
      ]
    }
  }
}
