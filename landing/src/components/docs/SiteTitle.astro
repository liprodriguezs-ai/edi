---
/**
 * Override de `SiteTitle` de Starlight.
 *
 * Sustituye el título de texto plano por la marca EDI + una etiqueta "Docs",
 * y hace que el logotipo sea la liga de regreso al sitio (el lugar donde todo
 * el mundo la busca). Sin esto, /docs se sentiría un sitio ajeno.
 */
import { meta } from '@/data/site';
---

<a href="/" class="k7-title" aria-label={`${meta.name} — ir al sitio`}>
  <img src="/edi-mark.svg" alt="" width="24" height="24" aria-hidden="true" />
  <span class="k7-word">{meta.name}</span>
  <span class="k7-chip">Docs</span>
</a>

<style>
  .k7-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: 21px;
    font-weight: 600;
    line-height: 1;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .k7-chip {
    font-family: var(--sl-font);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5a6957;
    background: #e6eae2;
    border-radius: 999px;
    padding: 2px 8px;
  }

  /* En móvil el header comparte espacio con el buscador y el menú: solo marca. */
  @media (max-width: 50em) {
    .k7-word {
      display: none;
    }
  }
</style>
