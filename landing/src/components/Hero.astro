---
import { hero, meta } from '@/data/site';
import Button from '@/components/Button.astro';
import AppWindow from '@/components/AppWindow.astro';
import heroDashboard from '@/assets/system/hero-dashboard.webp';
---

<section class="grid-bg relative overflow-hidden border-b border-line pb-20 pt-[124px]">
  <div
    class="wrap grid grid-cols-[0.95fr_1.05fr] items-center gap-x-14 gap-y-14 max-[980px]:grid-cols-1"
  >
    <!-- Texto -->
    <div class="text-left max-[980px]:text-center">
      <p
        class="mb-8 inline-flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.18em] text-brand-deep"
      >
        <span class="h-[7px] w-[7px] bg-brand-deep" aria-hidden="true"></span>
        {hero.badge}
      </p>

      <h1
        class="max-w-[15ch] text-[clamp(44px,6.4vw,80px)] font-extrabold leading-[0.98] tracking-[-0.045em] max-[980px]:mx-auto"
      >
        {hero.titleLead} <span class="text-brand-deep">{hero.titleEm}</span>
      </h1>

      <p class="mt-7 max-w-[46ch] text-[17.5px] text-ink-soft max-[980px]:mx-auto">
        {hero.ledeLead} <strong class="font-semibold text-ink">{hero.ledeStrong}</strong>
      </p>

      <div class="mt-10 flex flex-wrap gap-3.5 max-[980px]:justify-center">
        <Button href={hero.ctaPrimary.href} label={hero.ctaPrimary.label} event="StartTrial" />
        <Button href={hero.ctaSecondary.href} label={hero.ctaSecondary.label} variant="ghost" />
      </div>

      <ul
        class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[12.5px] text-ink-faint max-[980px]:justify-center"
      >
        {
          hero.proofs.map((proof) => (
            <li class="inline-flex items-center gap-1.5">
              <span class="h-1 w-1 bg-ink-faint" aria-hidden="true" />
              {proof.text}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Producto en capas (Dirección A) -->
    <div class="reveal reveal-d1 relative">
      <div
        class="pointer-events-none absolute -inset-x-6 top-[12%] h-[78%] bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-brand)_22%,transparent),transparent_75%)] blur-[34px]"
        aria-hidden="true"
      >
      </div>

      <div data-parallax="0.025" class="group relative">
        <AppWindow />
        <button
          type="button"
          data-lightbox
          data-lightbox-src={heroDashboard.src}
          data-lightbox-alt={`Tablero completo de ${meta.name}: resumen del mes con los tamizajes aplicados, su distribución en el semáforo del desarrollo, las áreas donde más falla el centro y los niños que requieren seguimiento.`}
          aria-haspopup="dialog"
          aria-label="Ver el panel de EDI ampliado"
          class="absolute inset-0 z-[1] cursor-zoom-in rounded-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-deep"
        >
          <span
            class="pointer-events-none absolute right-3 top-[54px] inline-flex items-center gap-1.5 bg-ink/80 px-3 py-1.5 text-[11px] font-medium text-paper opacity-0 transition-opacity duration-200 group-hover:opacity-100"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
              <path
                d="M9 4H5a1 1 0 00-1 1v4M15 4h4a1 1 0 011 1v4M9 20H5a1 1 0 01-1-1v-4M15 20h4a1 1 0 001-1v-4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              ></path>
            </svg>
            Ampliar
          </span>
        </button>
      </div>

      

      
    </div>
  </div>

  <script>
    // Parallax leve en las capas del hero. Gated por motion-safe-js (la clase la
    // agrega BaseLayout sólo si el usuario permite movimiento).
    const motionOk = document.documentElement.classList.contains('motion-safe-js');
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

    if (motionOk && layers.length) {
      let ticking = false;
      const apply = () => {
        const y = window.scrollY;
        for (const el of layers) {
          const factor = Number(el.dataset.parallax ?? '0');
          el.style.transform = `translate3d(0, ${(y * factor).toFixed(1)}px, 0)`;
        }
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(apply);
          }
        },
        { passive: true },
      );
      apply();
    }
  </script>
</section>
