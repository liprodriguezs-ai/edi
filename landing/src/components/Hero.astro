---
import { hero, meta } from '@/data/site';
import Button from '@/components/Button.astro';
import AppWindow from '@/components/AppWindow.astro';
import heroDashboard from '@/assets/system/hero-dashboard.webp';
---

<section class="relative overflow-hidden pb-16 pt-[150px]">
  <div
    class="wrap grid grid-cols-[0.95fr_1.05fr] items-center gap-x-14 gap-y-14 max-[980px]:grid-cols-1"
  >
    <!-- Texto -->
    <div class="text-left max-[980px]:text-center">
      <p
        class="mb-7 inline-flex items-center gap-[9px] rounded-full border border-[color-mix(in_srgb,var(--color-sage)_25%,transparent)] bg-sage-bg px-4 py-[7px] text-[12px] font-semibold tracking-[0.04em] text-sage-deep"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-sage" aria-hidden="true"></span>
        {hero.badge}
      </p>

      <h1
        class="max-w-[15ch] font-serif text-[clamp(40px,4.8vw,68px)] font-medium leading-[1.03] tracking-[-0.015em] max-[980px]:mx-auto"
      >
        {hero.titleLead} <em class="italic text-sage">{hero.titleEm}</em>
      </h1>

      <p class="mt-7 max-w-[46ch] text-[17.5px] text-ink-soft max-[980px]:mx-auto">
        {hero.ledeLead} <strong class="font-semibold text-ink">{hero.ledeStrong}</strong>
      </p>

      <div class="mt-10 flex flex-wrap gap-3.5 max-[980px]:justify-center">
        <Button href={hero.ctaPrimary.href} label={hero.ctaPrimary.label} event="StartTrial" />
        <Button href={hero.ctaSecondary.href} label={hero.ctaSecondary.label} variant="ghost" />
      </div>

      <ul
        class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[12.5px] text-ink-faint max-[980px]:justify-center"
      >
        {
          hero.proofs.map((proof) => (
            <li class="inline-flex items-center gap-1.5">
              <span class="text-sage" aria-hidden="true">
                ✓
              </span>
              {proof.text}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Producto en capas (Dirección A) -->
    <div class="reveal reveal-d1 relative">
      <div
        class="pointer-events-none absolute -inset-x-6 top-[12%] h-[78%] rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--color-sage)_22%,transparent),transparent_75%)] blur-[34px]"
        aria-hidden="true"
      >
      </div>

      <div data-parallax="0.025" class="group relative">
        <AppWindow />
        <button
          type="button"
          data-lightbox
          data-lightbox-src={heroDashboard.src}
          data-lightbox-alt={`Panel completo de ${meta.name}: navegación del organización, resumen del mes con ingresos, saldo en cuentas, adeudo y pagos recientes, y las gráficas de ingresos contra egresos.`}
          aria-haspopup="dialog"
          aria-label="Ver el panel de EDI ampliado"
          class="absolute inset-0 z-[1] cursor-zoom-in rounded-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-deep"
        >
          <span
            class="pointer-events-none absolute right-3 top-[54px] inline-flex items-center gap-1.5 rounded-full bg-ink/80 px-3 py-1.5 text-[11px] font-medium text-paper opacity-0 backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100"
          >
            <svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
              <path
                d="M9 4H5a1 1 0 00-1 1v4M15 4h4a1 1 0 011 1v4M9 20H5a1 1 0 01-1-1v-4M15 20h4a1 1 0 001-1v-4"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              ></path>
            </svg>
            Ampliar
          </span>
        </button>
      </div>

      <!-- chip flotante: recaudación -->
      <div
        data-parallax="-0.05"
        class="pointer-events-none absolute -left-4 -top-4 hidden rounded-xl border border-line bg-white/95 px-4 py-3 shadow-[0_18px_40px_-22px_rgba(20,24,26,0.4)] backdrop-blur-sm sm:block"
      >
        <p class="font-serif text-[20px] font-semibold leading-none text-sage-deep">
          <span data-money="48200" data-prefix="+ $">+ $48,200</span>
        </p>
        <p class="mt-1 text-[11px] text-ink-faint">recaudado hoy</p>
      </div>

      <!-- chip flotante: estado -->
      <div
        data-parallax="0.06"
        class="pointer-events-none absolute -bottom-4 -right-4 hidden items-center gap-2 rounded-xl border border-line bg-white/95 px-4 py-3 shadow-[0_18px_40px_-22px_rgba(20,24,26,0.4)] backdrop-blur-sm sm:flex"
      >
        <span class="h-2 w-2 rounded-full bg-ok" aria-hidden="true"></span>
        <span class="text-[12.5px] font-semibold text-ink">98% al día</span>
      </div>
    </div>
  </div>

  <script>
    // Parallax leve en las capas del hero. Gated por motion-safe-js (la clase la
    // agrega BaseLayout sólo si el usuario permite movimiento).
    const motionOk = document.documentElement.classList.contains('motion-safe-js');
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

    if (motionOk && layers.length) {
      let ticking = false;
      const apply = () => {
        const y = window.scrollY;
        for (const el of layers) {
          const factor = Number(el.dataset.parallax ?? '0');
          el.style.transform = `translate3d(0, ${(y * factor).toFixed(1)}px, 0)`;
        }
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(apply);
          }
        },
        { passive: true },
      );
      apply();
    }
  </script>
</section>
