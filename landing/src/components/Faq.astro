---
import { faq } from '@/data/site';
import SectionHead from '@/components/SectionHead.astro';
---

<section id="faq" class="scroll-mt-24 pb-32 pt-24" aria-labelledby="faq-title">
  <div class="wrap">
    <SectionHead eyebrow={faq.eyebrow} titleLead={faq.title} titleId="faq-title" />

    <div class="reveal mx-auto max-w-[760px] border-t border-line">
      {
        faq.items.map((item) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-bold tracking-[-0.035em] text-[21px] leading-snug [&::-webkit-details-marker]:hidden">
              {item.q}
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                class="h-5 w-5 flex-none text-brand-deep transition-transform duration-200 group-open:rotate-180"
              >
                <path
                  d="M6 9l6 6 6-6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <p class="max-w-[64ch] pb-5 text-[15px] text-ink-soft">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
