---
import { meta, footerLinks, footerLegal } from '@/data/site';
---

<footer class="pb-16">
  <div class="wrap">
    <div class="flex flex-wrap items-center justify-between gap-6 border-t border-line pt-12">
      <span class="flex items-center gap-2 font-serif text-[21px] font-semibold">
        <img src="/kivo7-mark.svg" alt="" class="h-6 w-auto" aria-hidden="true" />
        {meta.name}
      </span>
      <nav aria-label="Pie de página" class="flex flex-wrap gap-8">
        {
          footerLinks.map((link) => (
            <a href={link.href} class="text-[13px] text-ink-soft transition-colors hover:text-ink">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="mt-8 text-[11.5px] text-ink-faint">{footerLegal}</p>
  </div>
</footer>
