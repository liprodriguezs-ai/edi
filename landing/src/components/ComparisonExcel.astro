---
import { comparison } from '@/data/site';
import SectionHead from '@/components/SectionHead.astro';
---

<section id="comparativa" class="scroll-mt-24 pb-32 pt-24" aria-labelledby="comparison-title">
  <div class="wrap">
    <SectionHead eyebrow={comparison.eyebrow} titleLead={comparison.title} titleId="comparison-title" />

    <div
      class="reveal mx-auto grid max-w-[980px] grid-cols-2 overflow-hidden rounded-band border border-line shadow-card max-[760px]:grid-cols-1"
    >
      {/* Antes — papel */}
      <div class="bg-paper-2 p-12 max-[760px]:p-8">
        <p class="mb-7 text-[11.5px] font-semibold uppercase tracking-[0.18em] text-[#f0634c]">
          {comparison.beforeLabel}
        </p>
        <ul class="flex flex-col gap-4">
          {
            comparison.rows.map((row) => (
              <li class="flex items-start gap-3 text-[15px] text-ink-soft">
                <span
                  aria-hidden="true"
                  class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center bg-[#2b1310] text-[12px] font-bold text-bad"
                >
                  ✕
                </span>
                {row.before}
              </li>
            ))
          }
        </ul>
      </div>

      {/* Después — EDI (franja oscura, 1er momento de contraste) */}
      <div class="bg-[linear-gradient(160deg,#141719,#0b0d0f)] p-12 text-paper max-[760px]:p-8">
        <p class="mb-7 text-[11.5px] font-semibold uppercase tracking-[0.18em] text-[#a8adb2]">
          {comparison.afterLabel}
        </p>
        <ul class="flex flex-col gap-4">
          {
            comparison.rows.map((row) => (
              <li class="flex items-start gap-3 text-[15px] text-[#1f2427]">
                <span
                  aria-hidden="true"
                  class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center bg-brand text-[12px] font-bold text-white"
                >
                  ✓
                </span>
                <b class="font-semibold text-paper">{row.after}</b>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
