---
import { meta } from '@/data/site';

// Mock del producto renderizado en HTML (no es un screenshot) → nítido en
// cualquier densidad de pantalla, responsive y liviano. Muestra el valor real:
// el resumen del periodo con el semáforo del tamiz (animado) y los últimos
// tamizajes aplicados.
//
// Datos de muestra. La distribución respeta el resumen (76% / 18% / 6%) para
// que el mock sea internamente coherente.
const stats = [
  { label: 'Tamizajes del mes', amount: 148, caption: 'Aplicados y cerrados', dot: 'bg-ink' },
  { label: 'Desarrollo normal', amount: 112, caption: '76% del total', dot: 'bg-ok' },
  { label: 'Rezago', amount: 27, caption: 'Pasan a estimulación', dot: 'bg-warn' },
  { label: 'Riesgo de retraso', amount: 9, caption: 'Referidos a especialista', dot: 'bg-bad' },
];

type Verdict = { label: string; dot: string; tone: string };
const NORMAL: Verdict = { label: 'Normal', dot: 'bg-ok', tone: 'text-ok' };
const REZAGO: Verdict = { label: 'Rezago', dot: 'bg-warn', tone: 'text-warn' };
const RIESGO: Verdict = { label: 'Riesgo', dot: 'bg-bad', tone: 'text-bad' };

const screenings = [
  { child: 'Ximena Robles Cadena', age: '18 m · grupo 09', note: 'LE', verdict: REZAGO },
  { child: 'Emiliano Vargas Ruiz', age: '33 m · grupo 11', note: '—', verdict: NORMAL },
  { child: 'Renata Chávez Solís', age: '7 m · grupo 05', note: 'MG, LE', verdict: RIESGO },
];
---

<figure
  class="relative mx-auto max-w-[1020px] overflow-hidden rounded-card border border-line bg-card text-left"
>
  <div aria-hidden="true">
    <!-- window chrome -->
    <div class="flex h-10 items-center gap-2 border-b border-line-soft bg-card px-[18px]">
      <span class="h-[9px] w-[9px] bg-line"></span>
      <span class="h-[9px] w-[9px] bg-line"></span>
      <span class="h-[9px] w-[9px] bg-line"></span>
      <span class="ml-3.5 text-[11px] tracking-[0.03em] text-ink-faint">
        {meta.appHost} · CS Xochimilco
      </span>
    </div>

    <!-- tablero (HTML, siempre nítido) -->
    <div class="bg-paper/30 p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-[9.5px] font-semibold uppercase tracking-[0.14em] text-ink-faint">
            CS Xochimilco · Junio 2026
          </p>
          <p class="mt-1 font-bold tracking-[-0.035em] text-[22px] leading-none">Resumen del mes</p>
        </div>
        <span
          class="inline-flex flex-none items-center bg-brand-deep px-2.5 py-1.5 text-[10px] font-semibold text-white"
        >
          + Nuevo tamiz
        </span>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-2.5">
        {
          stats.map((s) => (
            <div class="border border-line bg-card p-3">
              <p class="flex items-center gap-1.5 text-[9.5px] text-ink-faint">
                <span class={`h-1.5 w-1.5  ${s.dot}`} />
                {s.label}
              </p>
              <p class="mt-1 text-[19px] font-semibold tracking-[-0.01em] text-ink">
                <span data-count={s.amount}>{s.amount.toLocaleString('es-MX')}</span>
              </p>
              <p class="text-[9px] text-ink-faint">{s.caption}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-3 border border-line bg-card p-3">
        <div class="flex items-center justify-between">
          <p class="text-[10.5px] font-semibold text-ink">Últimos tamizajes</p>
          <span class="text-[9.5px] text-brand-deep">Ver todos →</span>
        </div>
        <ul class="mt-2 flex flex-col gap-2">
          {
            screenings.map((s) => (
              <li class="flex items-center justify-between gap-2 text-[10px]">
                <span class="min-w-0 truncate">
                  <span class="font-semibold text-ink">{s.child}</span>
                  <span class="text-ink-faint"> · {s.age}</span>
                </span>
                <span class="flex flex-none items-center gap-2">
                  <span class="text-ink-soft">{s.note}</span>
                  <span class="inline-flex items-center gap-1 bg-brand-bg px-1.5 py-0.5 text-[8.5px] font-semibold text-brand-deep">
                    <span class={`h-1 w-1  ${s.verdict.dot}`} />
                    {s.verdict.label}
                  </span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <figcaption class="sr-only">
    Vista del tablero de {meta.name}: resumen del mes con tamizajes aplicados, su distribución en el
    semáforo del desarrollo y los últimos tamizajes del centro.
  </figcaption>
</figure>

<script>
  // Count-up de las métricas del tablero. Gated por motion-safe-js (lo agrega
  // BaseLayout solo si el usuario permite movimiento); sin JS / reduced-motion
  // el valor final ya está en el DOM.
  const motionOk = document.documentElement.classList.contains('motion-safe-js');

  if (motionOk) {
    const fmt = (n: number) => Math.round(n).toLocaleString('es-MX');

    const animate = (el: HTMLElement) => {
      const to = Number(el.dataset.count ?? '0');
      const duration = 1300;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(to * eased);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = fmt(to);
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.4 },
    );

    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => io.observe(el));
  }
</script>
