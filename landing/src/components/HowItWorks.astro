---
import { howItWorks } from '@/data/site';
import SectionHead from '@/components/SectionHead.astro';
---

<section id="como-funciona" class="scroll-mt-24 pb-32 pt-24" aria-labelledby="how-title">
  <div class="wrap">
    <SectionHead
      eyebrow={howItWorks.eyebrow}
      titleLead={howItWorks.title}
      body={howItWorks.lede}
      titleId="how-title"
    />

    <ol class="mx-auto grid max-w-[1000px] grid-cols-3 gap-x-10 gap-y-12 max-[760px]:grid-cols-1">
      {
        howItWorks.steps.map((step, i) => (
          <li
            class:list={[
  'reveal border-t border-line pt-6',
              i === 1 && 'reveal-d1',
              i === 2 && 'reveal-d2',
            ]}
          >
            <span class="block font-bold tracking-[-0.035em] text-[44px] leading-none text-brand">{step.n}</span>
            <h3 class="mt-4 font-bold tracking-[-0.035em] text-[24px] leading-[1.1]">{step.title}</h3>
            <p class="mt-2 max-w-[34ch] text-[15px] text-ink-soft">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
