---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const formatted = post.data.pubDate.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<a
  href={`/blog/${post.id}`}
  class="reveal group flex flex-col rounded-card border border-line bg-card p-7 shadow-card transition-[transform,box-shadow] duration-200 hover:-translate-y-[3px] hover:"
>
  {
    post.data.tags.length > 0 && (
      <p class="mb-3 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="bg-brand-bg px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] text-brand-deep">
            {tag}
          </span>
        ))}
      </p>
    )
  }
  <h2
    class="font-bold tracking-[-0.035em] text-[24px] leading-[1.12] transition-colors group-hover:text-brand-deep"
  >
    {post.data.title}
  </h2>
  <p class="mt-3 line-clamp-3 text-[14.5px] text-ink-soft">{post.data.description}</p>
  <time datetime={post.data.pubDate.toISOString()} class="mt-5 text-[12px] text-ink-faint">
    {formatted}
  </time>
</a>
