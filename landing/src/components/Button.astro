---
import type { TrackEventName } from '@/lib/trackEvent';

type Variant = 'solid' | 'ghost' | 'light' | 'ghost-on-dark';
type Size = 'md' | 'sm';

interface Props {
  href: string;
  label: string;
  variant?: Variant;
  size?: Size;
  class?: string;
  /** Evento de marketing a disparar al hacer click, antes de navegar. Opcional — sin esto, el botón no trackea nada. */
  event?: TrackEventName;
}

const { href, label, variant = 'solid', size = 'md', class: extra = '', event } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-[9px] font-mono uppercase tracking-[0.1em] font-medium whitespace-nowrap transition-colors duration-200';

const sizes: Record<Size, string> = {
  md: 'h-[46px] px-[22px] text-[11.5px]',
  sm: 'h-[34px] px-[15px] text-[11px]',
};

const variants: Record<Variant, string> = {
  // el acento es FONDO y lleva tinta blanca; como texto no alcanza contraste
  solid: 'bg-brand text-white hover:bg-brand-deep hover:text-paper',
  ghost: 'border border-line-2 text-ink hover:border-ink',
  light: 'bg-ink text-paper hover:bg-brand hover:text-white',
  'ghost-on-dark': 'border border-white/30 text-paper hover:border-white/70',
};
---

<a href={href} data-track-event={event} class:list={[base, sizes[size], variants[variant], extra]}
  >{label}</a
>

<script>
  // Delegación en document: Astro dedupea este bloque una sola vez por página
  // aunque <Button> se use muchas veces, así que un solo listener cubre todas
  // las instancias. El fetch de trackEvent va con `keepalive`, así que sigue
  // en vuelo aunque el click ya haya disparado la navegación del <a>.
  import { trackEvent, type TrackEventName } from '@/lib/trackEvent';

  document.addEventListener('click', (clickEvent) => {
    const target = clickEvent.target as HTMLElement | null;
    const cta = target?.closest<HTMLElement>('[data-track-event]');
    const name = cta?.dataset.trackEvent as TrackEventName | undefined;
    if (name) trackEvent(name);
  });
</script>
