---
import { results } from '@/data/site';
---

<section id="resultados" class="scroll-mt-24 pb-32">
  <h2 class="sr-only">Resultados</h2>
  <div
    class="reveal mx-auto grid max-w-page grid-cols-3 gap-px border border-line bg-line max-[1260px]:mx-8 max-[760px]:grid-cols-1"
  >
    {
      results.map((stat) => (
        <div class="bg-paper p-12 max-[760px]:p-10">
          <p class="text-[clamp(48px,5.5vw,72px)] font-extrabold leading-[0.92] tracking-[-0.045em]">
            {stat.prefix}
            <span data-count={stat.value}>{stat.value}</span>
            {stat.unit && <span class="text-[0.5em] font-medium text-ink-faint">{stat.unit}</span>}
          </p>
          <p class="mt-3 max-w-[26ch] text-[14px] leading-relaxed text-ink-soft">
            <b class="font-semibold text-ink">{stat.captionStrong}</b> {stat.caption}
          </p>
        </div>
      ))
    }
  </div>
</section>
