# Variables de entorno de la landing (Astro). Sólo las prefijadas con PUBLIC_
# quedan expuestas al cliente. Copiá este archivo a `.env` y ajustá los valores.

# URL de la app a donde apuntan los CTAs de "empezar/iniciar".
PUBLIC_APP_URL=https://app.kivo7.com

# Base de la API pública del backend que consume el Cotizador
# (GET /billing/catalog, POST /billing/quote). En desarrollo local:
PUBLIC_API_BASE_URL=http://localhost:8080/api
